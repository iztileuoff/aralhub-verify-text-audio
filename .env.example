APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where new recordings are written. Every audio row stores the disk it was
# uploaded to, so switching this leaves everything already uploaded readable.
AUDIO_DISK=yandex-s3
# Disk for rows recorded before `storage_disk` existed (NULL in the database).
AUDIO_LEGACY_DISK=yandex-s3

# Yandex Object Storage (the disk in use up to the switch).
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_DEFAULT_REGION=ru-central1
YANDEX_BUCKET_NAME=
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_URL=

# Cloudflare R2. Region is always "auto"; the endpoint is
# https://<account-id>.r2.cloudflarestorage.com. R2_URL must be the public
# r2.dev subdomain or a custom domain — playback URLs go straight to browsers.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_URL=

# Laravel Pulse (application monitoring, dashboard at /pulse).
# Access is restricted to admin/super-admin via the `viewPulse` gate.
PULSE_ENABLED=true
# Store metrics on a dedicated connection in production to keep load off the app DB.
PULSE_DB_CONNECTION=
# Use "redis" to offload writes from the request cycle (requires `php artisan pulse:work`).
PULSE_INGEST_DRIVER=storage
PULSE_REDIS_CONNECTION=
# Hostname shown on the Servers card (requires `php artisan pulse:check` running).
PULSE_SERVER_NAME=

VITE_APP_NAME="${APP_NAME}"
